<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Product</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">

  <div class="grid grid-cols-1 lg:grid-cols-4 min-h-screen">

    <!-- 🔵 LEFT SIDEBAR -->
    <aside class="bg-indigo-600 text-white p-6">
      <h2 class="text-2xl font-bold mb-8">Admin Panel</h2>

      <nav class="space-y-4">
        <a href="/products"
           class="block px-4 py-2 rounded-lg bg-indigo-700 hover:bg-indigo-800 transition">
          📦 View Products
        </a>

       
      </nav>
    </aside>

    <!-- 🟢 MAIN CONTENT -->
    <main class="lg:col-span-3 p-6">

      <form 
        class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-lg space-y-6"
        action="/products/create"
        method="post"
        enctype="multipart/form-data">

        <h2 class="text-2xl font-bold text-gray-800 text-center">
          Add Product
        </h2>

        <!-- Product Name -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            Product Name
          </label>
          <input type="text" name="Name" placeholder="Enter product name"
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>

        <!-- Price -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            Price
          </label>
          <input type="number" name="price" placeholder="Enter price"
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>

        <!-- Discount -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            Discount
          </label>
          <input type="number" name="Discount" placeholder="Enter discount"
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>

        <!-- Colors -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              Background Color
            </label>
            <input type="color" name="bgcolor"
              class="w-full h-11 border rounded-lg">
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              Text Color
            </label>
            <input type="color" name="textcolor"
              class="w-full h-11 border rounded-lg">
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              Panel Color
            </label>
            <input type="color" name="pannelcolor"
              class="w-full h-11 border rounded-lg">
          </div>

        </div>

        <!-- Image Upload -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            Product Image
          </label>
          <input type="file" name="img"
            class="w-full text-sm
              file:mr-4 file:py-2 file:px-4
              file:rounded-lg file:border-0
              file:bg-indigo-600 file:text-white
              hover:file:bg-indigo-700">
        </div>

        <!-- Submit -->
        <div class="text-right">
          <button type="submit"
            class="px-6 py-2 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition">
            Add Product
          </button>
        </div>

      </form>

    </main>

  </div>

</body>
</html>
