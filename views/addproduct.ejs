<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
      <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <form 
    class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-lg space-y-6"
     action="/products/create" method="post"
     enctype="multipart/form-data">

  <h2 class="text-2xl font-bold text-gray-800 text-center">
    Add Product
  </h2>

  <!-- Product Name -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">
      Product Name
    </label>
    <input type="text" placeholder="Enter product name" name="Name"
      class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
  </div>

  <!-- Price -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">
      Price
    </label>
    <input type="number" placeholder="Enter price" name="price"
      class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
  </div>

  <!-- Description -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">
      Discount
    </label>
    <input type="number" placeholder="Enter product discount" name="Discount"
      class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
  </div>

  <!-- Colors -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Background Color
      </label>
      <input type="color" class="w-full h-11 border rounded-lg" name="bgcolor">
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1" >
        Text Color
      </label>
      <input type="color" class="w-full h-11 border rounded-lg" name="textcolor">
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        Panel Color
      </label>
      <input type="color" class="w-full h-11 border rounded-lg" name="pannelcolor">
    </div>

  </div>

  <!-- Image Upload -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">
      Product Image
    </label>
    <input type="file"
    name="img"
      class="w-full text-sm file:mr-4 file:py-2 file:px-4
             file:rounded-lg file:border-0
             file:bg-blue-600 file:text-white
             hover:file:bg-blue-700">
  </div>

  <!-- Submit Button -->
  <div class="text-right">
    <button type="submit"
      class="px-6 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">
      Add Product
    </button>
  </div>

</form>

</body>
</html>